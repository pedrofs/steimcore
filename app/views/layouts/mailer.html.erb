<% font = MailerHelper::BRAND_FONT %>
<% brand = MailerHelper::BRAND_COLOR %>
<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= MailerHelper::BRAND_NAME %></title>
  </head>
  <body style="margin:0;padding:0;background-color:#f4f4f5;font-family:<%= font %>;color:#18181b;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f4f5;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;background-color:#ffffff;border:1px solid #e4e4e7;border-radius:10px;border-collapse:separate;overflow:hidden;">
            <tr>
              <td style="height:4px;background-color:<%= brand %>;line-height:4px;font-size:4px;">&nbsp;</td>
            </tr>
            <tr>
              <td style="padding:24px 24px 20px 24px;border-bottom:1px solid #f0f0f1;">
                <%= brand_logo %>
              </td>
            </tr>
            <tr>
              <td style="padding:32px 24px;font-size:16px;line-height:1.6;color:#18181b;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 24px 26px 24px;border-top:1px solid #e4e4e7;font-size:12px;line-height:1.6;color:#71717a;">
                Enviado por <strong style="color:#52525b;"><%= MailerHelper::BRAND_NAME %></strong><br>
                © <%= Date.current.year %> <%= MailerHelper::BRAND_NAME %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
